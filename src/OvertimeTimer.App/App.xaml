<prism:PrismApplication x:Class="OvertimeTimer.App.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="http://prismlibrary.com/"
                        xmlns:hc="https://handyorg.github.io/handycontrol"
                        xmlns:views="clr-namespace:OvertimeTimer.App.Views"
                        xmlns:viewModels="clr-namespace:OvertimeTimer.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <hc:ThemeResources/>
                <hc:Theme/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF0F172A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF64748B" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEFF6FF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6" />
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#FFEAF3FF" />
            <SolidColorBrush x:Key="OvertimeBrush" Color="#FFDC2626" />
            <SolidColorBrush x:Key="DiaryBrush" Color="#FF16A34A" />
            <SolidColorBrush x:Key="ShellBorderBrush" Color="#FFE2E8F0" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <DataTemplate DataType="{x:Type viewModels:MainViewModel}">
                <views:MainView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
