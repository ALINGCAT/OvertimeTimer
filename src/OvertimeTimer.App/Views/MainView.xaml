<UserControl x:Class="OvertimeTimer.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:design="clr-namespace:OvertimeTimer.App.DesignTime"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <hc:Card Grid.Column="0" Margin="0,0,6,0" Padding="16">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Margin="0,0,8,0"
                            Width="22"
                            Height="22"
                            Padding="0"
                            Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="设置">
                        <TextBlock FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="⚙" >
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="0.5" Y="0.5" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <TextBlock Grid.Column="1"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding YearMonthLabel}" />
                    <Button Grid.Column="2"
                            Margin="8,0,0,0"
                            Width="22"
                            Height="22"
                            Padding="0"
                            Command="{Binding OpenMonthPickerCommand}">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="&#xE70D;" />
                    </Button>
                </Grid>

                <UniformGrid Grid.Row="1"
                             Columns="7"
                             Width="322"
                             Margin="0,0,0,4">
                    <TextBlock HorizontalAlignment="Center" Text="周一" />
                    <TextBlock HorizontalAlignment="Center" Text="周二" />
                    <TextBlock HorizontalAlignment="Center" Text="周三" />
                    <TextBlock HorizontalAlignment="Center" Text="周四" />
                    <TextBlock HorizontalAlignment="Center" Text="周五" />
                    <TextBlock HorizontalAlignment="Center" Text="周六" />
                    <TextBlock HorizontalAlignment="Center" Text="周日" />
                </UniformGrid>

                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding CalendarDays}"
                              Width="322"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,2,4,2" Background="Transparent">
                                <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Width="38"
                                        Height="38"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="6">
                                                            <Grid>
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseDirectlyOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Root" Property="Background" Value="#FFD9EAFD" />
                                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Root" Property="BorderBrush" Value="#FFF59E0B" />
                                                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DayNumber}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="#FF22C55E" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInCurrentMonth}" Value="False">
                                                            <Setter Property="Foreground" Value="#FFE2E8F0" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRestDayOvertimeHighlighted}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource OvertimeBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock HorizontalAlignment="Left"
                                                   VerticalAlignment="Top"
                                                   Margin="4,3,0,0"
                                                   Foreground="{DynamicResource OvertimeBrush}"
                                                   Text="●"
                                                   Visibility="{Binding HasOvertime, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,4,3"
                                                   Foreground="{DynamicResource DiaryBrush}"
                                                   Text="●"
                                                   Visibility="{Binding HasDiary, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding SelectedDateLabel}" />
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Text="加班时长" />
                            <hc:NumericUpDown Grid.Column="1"
                                          Width="64"
                                          Minimum="0"
                                          Maximum="999"
                                          Value="{Binding SelectedDayRecord.OvertimeHours}" />
                            <TextBlock Grid.Column="2"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Text="小时" />
                            <hc:NumericUpDown Grid.Column="3"
                                          Width="64"
                                          Minimum="0"
                                          Maximum="59"
                                          Value="{Binding SelectedDayRecord.OvertimeMinutes}" />
                            <TextBlock Grid.Column="4"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   Text="分钟" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding MonthlyOvertimeSummary, StringFormat=总计加班时长：{0}}" />
                        <Button Grid.Column="1"
                                Margin="12,0,0,0"
                                HorizontalAlignment="Right"
                                Command="{Binding SelectedDayRecord.SaveCommand}"
                                Content="保存" />
                    </Grid>
                </Grid>
            </Grid>
        </hc:Card>

        <hc:Card Grid.Column="1" Margin="6,0,0,0" Padding="16">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" Text="Markdown 日记" />
                        <hc:TextBox Grid.Row="1"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Padding="5"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalContentAlignment="Top"
                                    Text="{Binding SelectedDayRecord.DiaryMarkdown}" />
                        </Grid>

                    <Grid Grid.Column="1" Margin="6,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" Text="预览" />
                        <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding SelectedDayRecord.DiaryPreview}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </hc:Card>
    </Grid>
</UserControl>
