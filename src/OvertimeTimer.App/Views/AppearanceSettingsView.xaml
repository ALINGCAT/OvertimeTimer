<UserControl x:Class="OvertimeTimer.App.Views.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:OvertimeTimer.App.Localization"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:OvertimeTimer.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AppearanceSettingsViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.WindowBackground}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding WindowBackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="WindowBackgroundColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding WindowBackgroundColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CardBackground}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CardBackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CardBackgroundColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CardBackgroundColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CardBorder}" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CardBorderColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="2" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CardBorderColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CardBorderColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CalendarWorkday}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CalendarWorkdayColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="3" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CalendarWorkdayColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CalendarWorkdayColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CalendarRestDay}" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CalendarRestDayColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="4" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CalendarRestDayColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CalendarRestDayColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CalendarToday}" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CalendarTodayColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="5" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CalendarTodayColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CalendarTodayColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CalendarOutOfMonth}" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CalendarOutOfMonthColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="6" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CalendarOutOfMonthColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CalendarOutOfMonthColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CalendarOvertimeDot}" />
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CalendarOvertimeDotColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="7" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CalendarOvertimeDotColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CalendarOvertimeDotColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CalendarDiaryDot}" />
            <TextBox Grid.Row="8" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CalendarDiaryDotColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="8" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CalendarDiaryDotColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CalendarDiaryDotColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.CalendarHoliday}" />
            <TextBox Grid.Row="9" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding CalendarHolidayColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="9" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CalendarHolidayColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CalendarHolidayColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"
                       Text="{loc:Loc Appearance.CalendarAdjustWorkday}" />
            <TextBox Grid.Row="10" Grid.Column="1" Margin="0,0,12,0"
                     Text="{Binding CalendarAdjustWorkdayColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="10" Grid.Column="2" Width="44" Height="24" Padding="0"
                    Command="{Binding ChooseColorCommand}" CommandParameter="CalendarAdjustWorkdayColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding CalendarAdjustWorkdayColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" HorizontalAlignment="Left" Command="{Binding SaveCommand}" Content="{loc:Loc Settings.Save}" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource InlineSaveFeedbackTextStyle}"
                       Visibility="{Binding HasSaveFeedback, Converter={StaticResource BoolToVisibility}}"
                       Text="{Binding SaveFeedbackMessage}" />
        </Grid>
    </Grid>
</UserControl>
