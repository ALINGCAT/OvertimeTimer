<UserControl x:Class="OvertimeTimer.App.Views.PreviewSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:OvertimeTimer.App.Localization"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:OvertimeTimer.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PreviewSettingsViewModel, IsDesignTimeCreatable=False}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,14"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{loc:Loc Appearance.PreviewColorHint}"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,0,12,8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="{loc:Loc Appearance.PreviewFont}" />
        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,0,12,8"
                  IsEditable="True"
                  ItemsSource="{Binding AvailableFontFamilies}"
                  Text="{Binding PreviewFontFamily, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,0,12,8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="{loc:Loc Appearance.FontSize}" />
        <hc:NumericUpDown Grid.Row="2"
                          Grid.Column="1"
                          Width="80"
                          Margin="0,0,12,8"
                          HorizontalAlignment="Left"
                          Maximum="32"
                          Minimum="8"
                          Value="{Binding PreviewFontSize}" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Margin="0,0,12,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Text="{loc:Loc Appearance.PreviewCodeFont}" />
        <ComboBox Grid.Row="3"
                  Grid.Column="1"
                  Margin="0,0,12,0"
                  IsEditable="True"
                  ItemsSource="{Binding AvailableCodeFontFamilies}"
                  Text="{Binding PreviewCodeFontFamily, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Grid.Row="4"
                   Grid.ColumnSpan="2"
                   Style="{StaticResource InlineSaveFeedbackTextStyle}"
                   Visibility="{Binding HasSaveFeedback, Converter={StaticResource BoolToVisibility}}"
                   Text="{Binding SaveFeedbackMessage}" />
    </Grid>
</UserControl>
