<UserControl x:Class="OvertimeTimer.App.Views.PreviewSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="clr-namespace:OvertimeTimer.App.Localization"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:OvertimeTimer.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PreviewSettingsViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.PreviewBackground}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding PreviewBackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="PreviewBackgroundColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding PreviewBackgroundColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.PreviewText}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding PreviewTextColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="1" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="PreviewTextColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding PreviewTextColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.PreviewLink}" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding PreviewLinkColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="2" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="PreviewLinkColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding PreviewLinkColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.PreviewCodeBackground}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,12,8"
                     Text="{Binding PreviewCodeBackgroundColor, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="3" Grid.Column="2" Width="44" Height="24" Padding="0" Margin="0,0,0,8"
                    Command="{Binding ChooseColorCommand}" CommandParameter="PreviewCodeBackgroundColor">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ShellBorderBrush}" />
                        <Setter Property="Background" Value="{Binding PreviewCodeBackgroundColor, Converter={StaticResource ColorTextToBrushConverter}}" />
                    </Style>
                </Button.Style>
            </Button>

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.PreviewFont}" />
            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,12,8" IsEditable="True"
                      ItemsSource="{Binding AvailableFontFamilies}"
                      Text="{Binding PreviewFontFamily, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.FontSize}" />
            <hc:NumericUpDown Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,12,8"
                              Minimum="8" Maximum="32" Value="{Binding PreviewFontSize}" />

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,8"
                       Text="{loc:Loc Appearance.LineHeight}" />
            <hc:NumericUpDown Grid.Row="6" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,12,8"
                              Minimum="12" Maximum="48" Value="{Binding PreviewLineHeight}" />

            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"
                       Text="{loc:Loc Appearance.PreviewCodeFont}" />
            <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,0,12,0" IsEditable="True"
                      ItemsSource="{Binding AvailableCodeFontFamilies}"
                      Text="{Binding PreviewCodeFontFamily, UpdateSourceTrigger=LostFocus}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" HorizontalAlignment="Left" Command="{Binding SaveCommand}" Content="{loc:Loc Settings.Save}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ExportCssCommand}" Content="{loc:Loc Settings.ExportCss}" />
            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding ImportCssCommand}" Content="{loc:Loc Settings.ImportCss}" />
            <TextBlock Grid.Column="3"
                       Style="{StaticResource InlineSaveFeedbackTextStyle}"
                       Visibility="{Binding HasSaveFeedback, Converter={StaticResource BoolToVisibility}}"
                       Text="{Binding SaveFeedbackMessage}" />
        </Grid>
    </Grid>
</UserControl>
