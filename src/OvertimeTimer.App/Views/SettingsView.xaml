<UserControl x:Class="OvertimeTimer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:design="clr-namespace:OvertimeTimer.App.DesignTime"
             xmlns:views="clr-namespace:OvertimeTimer.App.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DataContext="{d:DesignInstance Type=design:DesignSettingsViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <hc:Card Padding="16">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Margin="0,0,0,8" Command="{Binding ShowWorkScheduleSectionCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkScheduleSectionSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="工作日规则" />
                    </Button>

                    <Button Grid.Row="1" Margin="0,0,0,8" Command="{Binding ShowStorageSectionCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStorageSectionSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="存储设置" />
                    </Button>

                    <Button Grid.Row="2" Margin="0,0,0,8" Command="{Binding ShowAppearanceSectionCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAppearanceSectionSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="外观设置" />
                    </Button>

                    <Button Grid.Row="3" Command="{Binding ShowLanguageSectionCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLanguageSectionSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="语言设置" />
                    </Button>
                </Grid>

                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding CurrentSectionTitle}" />

                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding CurrentSectionDescription}" />

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid Visibility="{Binding IsWorkScheduleSectionSelected, Converter={StaticResource BoolToVisibility}}">
                            <views:WorkScheduleSettingsView DataContext="{Binding WorkScheduleSection}" />
                        </Grid>
                        <Grid Visibility="{Binding IsStorageSectionSelected, Converter={StaticResource BoolToVisibility}}">
                            <views:StorageSettingsView DataContext="{Binding StorageSection}" />
                        </Grid>
                        <Grid Visibility="{Binding IsAppearanceSectionSelected, Converter={StaticResource BoolToVisibility}}">
                            <views:AppearanceSettingsView DataContext="{Binding AppearanceSection}" />
                        </Grid>
                        <Grid Visibility="{Binding IsLanguageSectionSelected, Converter={StaticResource BoolToVisibility}}">
                            <views:LanguageSettingsView DataContext="{Binding LanguageSection}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </hc:Card>
    </ScrollViewer>
</UserControl>
